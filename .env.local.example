# React Bits Pro (required for Hexagonal Vault / Pro components)
REACTBITS_LICENSE_KEY=

# Database
MONGODB_URI=

# Auth (admin JWT secret / bootstrap admin credentials)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave empty to use same-origin /api
NEXT_PUBLIC_API_URL=
# Optional: override endpoint used by contact/enquiry forms (default: /api/send-form)
NEXT_PUBLIC_SEND_FORM_URL=

# Lead notification email (optional SMTP; leads are always saved to DB)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# CORS allow-list for cross-origin callers (comma separated, optional)
CLIENT_URL=
ADMIN_URL=
